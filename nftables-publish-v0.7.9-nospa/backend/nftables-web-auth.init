#!/bin/sh /etc/rc.common
# 认证网关服务（进程 B）
#
# 职责：只提供 /auth/* 认证端点，监听 127.0.0.1，公网完全不可达。
# 公网入口由 nginx（gateway_port）承担，通过 auth_request 调用本服务。
#
# 与面板（进程 A，5443）的关系：两个独立进程、两个独立 init 服务。
# 刻意不合并 —— 面板崩了不该带走认证，认证崩了面板仍能在 LAN 上修问题。
# 本服务不 import app.py，只读同一份 config.json。

START=98
STOP=11

APP_DIR="/opt/nftables-web-v2/backend"
AUTH_LOG="/var/log/nftables-web-auth-gateway.log"
PID_FILE="/var/run/nftables-web-auth.pid"

# 监听地址写死 127.0.0.1，不要改成 0.0.0.0。
# auth_gateway.py 启动时会检查 AUTH_BIND_HOST，绑到非回环地址直接退出。
AUTH_BIND_HOST="127.0.0.1"

# ══════════════════════════════════════════════════════════════════════
# 权限降级
#
# 本服务是**唯一直接处理公网请求的进程**（面板仅 LAN、本服务仅回环，
# 但 nginx 的 auth_request 会把公网流量送进来）。以 root 运行时，
# 网关侧任何一处 RCE 都等于整台机器沦陷：
#   nft flush ruleset  → 防火墙全开
#   kill 看门狗进程     → 规则集清空后永远不再自愈
# 看门狗挡不住这个 —— 它和被保护对象在同一个 root 权限域，攻击者拿到
# root 的第一件事就是关掉它。所以降权是唯一有效的收敛手段。
#
# OpenWrt 没有 useradd/adduser（busybox 未编译这些 applet），建用户的
# 办法就是直接往 /etc/passwd、/etc/group 追加一行 —— dnsmasq / logd /
# ubus 这些系统账号本来也都是各包 postinst 这样写进去的。
# /etc 在 overlay(/dev/loop0 ext4) 上，所以建一次长期有效。
# ══════════════════════════════════════════════════════════════════════

NFTWEB_USER="nftweb"
NFTWEB_UID=""
NFTWEB_GID=""

_find_free_id() {
    # 在 $2..$3 区间里找第一个没被 $1 占用的 id
    _file="$1"; _lo="$2"; _hi="$3"; _i="$_lo"
    while [ "$_i" -le "$_hi" ]; do
        if ! awk -F: -v n="$_i" '$3==n {found=1} END{exit found?0:1}' "$_file"; then
            echo "$_i"
            return 0
        fi
        _i=$((_i + 1))
    done
    return 1
}

ensure_nftweb_user() {
    if grep -q "^${NFTWEB_USER}:" /etc/passwd 2>/dev/null; then
        NFTWEB_UID=$(awk -F: -v u="$NFTWEB_USER" '$1==u {print $3}' /etc/passwd)
        NFTWEB_GID=$(awk -F: -v u="$NFTWEB_USER" '$1==u {print $4}' /etc/passwd)
        [ -n "$NFTWEB_UID" ] && [ -n "$NFTWEB_GID" ] && return 0
        echo "  $NFTWEB_USER 已在 /etc/passwd 里但 uid/gid 读不出来，请人工检查" >&2
        return 1
    fi

    NFTWEB_GID=$(_find_free_id /etc/group 1000 1099) || {
        echo "  /etc/group 1000-1099 无空闲 GID" >&2; return 1; }
    NFTWEB_UID=$(_find_free_id /etc/passwd 1000 1099) || {
        echo "  /etc/passwd 1000-1099 无空闲 UID" >&2; return 1; }

    echo "${NFTWEB_USER}:x:${NFTWEB_GID}:${NFTWEB_USER}:" >> /etc/group
    echo "${NFTWEB_USER}:x:${NFTWEB_UID}:${NFTWEB_GID}:${NFTWEB_USER}:/var/nftables-web:/bin/false" >> /etc/passwd
    mkdir -p /var/nftables-web
    echo "  已创建 ${NFTWEB_USER} uid=${NFTWEB_UID} gid=${NFTWEB_GID}"
}

# 判断一个文件是不是**合法的 JSON 对象**。
#   0 = 是（能当成 JSON 对象用）
#   1 = 不是 / 判断不了
#
# 为什么必须是「对象」而不是「任意合法 JSON」：网关那边
# load_revoked() 明确要求 isinstance(data, dict)，限流表那边
# 遇到非 dict 也直接当空表处理 —— 播进去一个 [1,2] 或 "x"
# 对网关来说跟坏文件没区别。
#
# 为什么用 python3 而不是 grep：JSON 里可能有嵌套、可能有转义引号，
# 正则匹配出来的「端口/字段」是随机的。设备上 python3 是确定有的
# （网关本身就是 python3 跑起来的），所以这里直接用它解析。
_json_object_ok() {
    [ -f "$1" ] || return 1
    command -v python3 >/dev/null 2>&1 || return 1
    python3 -c 'import json,sys
try:
    d = json.load(open(sys.argv[1]))
except Exception:
    sys.exit(1)
sys.exit(0 if isinstance(d, dict) else 1)
' "$1" >/dev/null 2>&1
}

# 降权之后进程就建不出这些文件了（/etc/nftables 与 /var/log 都是 root 755），
# 所以必须在启动前以 root 身份准备好。每次 start 都重跑一遍，
# 兼作自愈：文件若被误删或被 app.py 重建成 root 属主，这里会修回来。
prepare_nftweb_files() {
    _cfgdir="/etc/nftables"

    # 目录 setgid：日后 app.py 以 root 重建文件时（新文件组默认跟目录走），
    # 组仍是 nftweb，降权后的网关才读得到密码/密钥。
    # 少了这一步，「用户改密码 → 文件被删后重建 → 属主变 root → 网关读不到
    # → 登录全断」这个坑就会在某个随机时刻炸开。
    chgrp "$NFTWEB_USER" "$_cfgdir" || return 1
    chmod g+s "$_cfgdir" || return 1

    # 目录本身的**模式位**也要归一化（Shannon 渗透测试 P2-28）。
    #
    # 原来只 chgrp + chmod g+s，模式位完全不管 —— 目录是 setup.sh 的
    # `mkdir -p` 建的（755，umask 说了算），也可能被手工改成 777。
    # 后果不是「文件权限没生效」，而是这个目录里躺着网关令牌密钥、面板
    # 会话密钥、共享配置和口令哈希，而**目录对其他用户是可列可进的**：
    # 里面的文件权限再严也没用，别的账号能进来一个个试探。
    #
    # 2750 的含义：
    #   root      rwx   面板（root）要在这里建文件
    #   nftweb    r-x   网关（降权后）要 traverse 进去打开 640 的文件
    #   其他用户  ---   一律不许进
    #
    # 为什么 nftweb 组要 r：网关要按路径打开
    # /etc/nftables/nftables-web-config.json，目录上有 x 才穿得过去，
    # 有 r 才能列目录（排障时看得见文件在不在）。
    #
    # 为什么组里**没有**写权限：降权后的网关建不了新文件 —— 文件一律
    # 由 root 侧预建（下面的令牌密钥 / 限流表 / 吊销表都是这么准备的）。
    # 这条权限本来就没有（2755 的组也是 r-x），所以这里不改变网关的
    # 任何既有行为，只是把「其他用户」那一份收干净。
    chmod 2750 "$_cfgdir" || return 1

    # 密钥文件。两个，权限**相反** —— 别弄混：
    #
    #   nftables-web-secret          0640 root:nftweb  ← 网关的令牌密钥
    #   nftables-web-session-secret  0600 root:root    ← 面板的会话签名密钥
    #
    # 为什么必须分开（Shannon 渗透测试 finding）：
    # 以前面板的 Flask SECRET_KEY 和网关的令牌密钥读的是**同一个文件**
    # nftables-web-secret（0640 root:nftweb）—— 降权后的网关进程
    # （公网可达的那个）能读它。网关侧确实做了域分离
    # （HMAC(secret, "nftables-web/auth-token/v1")），日常不会拿它签面板
    # session，但域分离挡不住「攻陷后横向」：网关的 _load_secret() 是
    # **直接读原文件**再派生的 ⇒ 网关进程内存里就握着面板的会话签名密钥
    # ⇒ 网关一旦被攻陷，攻击者立刻能签出面板管理员 session。
    #
    # 拆开之后网关只拿得到令牌密钥，签不出面板 session。
    #
    # 两个文件都必须在**降权前**以 root 身份准备好（网关降权后建不了
    # /etc/nftables 下的新文件 —— 那个目录是 root 属组 nftweb 的 2755，
    # 组里没有写权限）。

    # ── 网关令牌密钥：不存在就生成 ────────────────────────────────
    # 已存在则**原样保留** —— 换了它所有已签发的令牌立刻作废，
    # 用户得重新登录网关。
    _toksecret="$_cfgdir/nftables-web-secret"
    if [ ! -s "$_toksecret" ]; then
        dd if=/dev/urandom bs=32 count=1 2>/dev/null \
            | hexdump -v -e '32/1 "%02x"' > "$_toksecret" || return 1
        [ -s "$_toksecret" ] || return 1
    fi
    chgrp "$NFTWEB_USER" "$_toksecret" || return 1
    chmod 640 "$_toksecret" || return 1

    # ── 面板会话签名密钥：不存在就生成，且**不给 nftweb 组任何权限** ──
    # 面板（root）读它，网关读不到 ⇒ 攻陷网关也签不出面板 session。
    _sesssecret="$_cfgdir/nftables-web-session-secret"
    if [ ! -s "$_sesssecret" ]; then
        dd if=/dev/urandom bs=32 count=1 2>/dev/null \
            | hexdump -v -e '32/1 "%02x"' > "$_sesssecret" || return 1
        [ -s "$_sesssecret" ] || return 1
    fi
    chown 0:0 "$_sesssecret" || return 1
    chmod 600 "$_sesssecret" || return 1

    # 只读类：root 拥有、nftweb 组可读。640 对「其他」仍然完全关闭，
    # 暴露面和原来的 600 等价，但网关读得到。
    # ⚠️ 这里**不能**包含 nftables-web-session-secret —— 那是面板的
    # 会话签名密钥，给了组读权限就等于把面板管理员会话的能力递给网关。
    #
    # nftables-web-config.json 也在这一类里：网关要读它（会话 TTL、
    # LAN 豁免、令牌世代号都在里面）。少了这一步，网关读不到配置就
    # **静默回退到默认值**（load_gateway_config 的注释写得很清楚：
    # 读失败返回空 dict）—— 不报错，只是行为跟配置对不上，
    # 全新安装时最容易踩（setup.sh 写的是 0600）。
    for f in nftables-web-password nftables-web-config.json; do
        [ -f "$_cfgdir/$f" ] || continue
        chgrp "$NFTWEB_USER" "$_cfgdir/$f" || return 1
        chmod 640 "$_cfgdir/$f" || return 1
    done

    # 读写类：网关自己写、自己 flock、自己 chmod 600，属主必须是它
    for f in nftables-web-auth-ratelimit.json nftables-web-auth-ratelimit-revoked.json; do
        # 必须播种成**合法 JSON**（{}），不能留 0 字节的空文件。
        #
        # 空文件不是合法 JSON —— 吊销表那边 load_revoked() 读不出来，
        # 又拿不到 last-known-good（进程刚起），就返回 None；
        # is_revoked() 于是对**所有** jti 判为「已吊销」（fail-closed）。
        # 结果是：登录接口照样返 200 并下发 token，但那个 token 立刻作废，
        # 门户永远把你弹回登录页 —— **全新安装必现**。
        #
        # 这里刻意不用「空文件也算合法」来绕过：
        # 能把吊销表截断成 0 字节的人，也能借此让已登出的 token 复活
        # （空表 = 没有吊销记录）。所以坏了就该 fail-closed，
        # 根因修在「建文件时就播成 {}」。
        #
        # 限流表那边读不出来会退化成空表（fail-open，只多试几次），
        # 不受这个影响；但两个文件都播 {} 更干净。
        #
        # 「非空但不是合法 JSON」也必须重播（Shannon 渗透测试 P2-4）。
        #
        # 原来只判「文件不存在或 0 字节」就播 {}，于是**写坏一半**的文件
        # （写到一半断电、磁盘满、进程被 kill）会原样留着 —— 而它跟 0 字节
        # 文件对网关是同一件事：读不出来。
        #
        # 对**吊销表**来说后果是致命的：load_revoked() 解析失败 → 进程刚起
        # 没有 last-known-good → 返回 None → is_revoked() 对所有 jti 判为
        # 「已吊销」（fail-closed）→ 登录接口照样返 200 并下发 token，
        # 但那个 token 立刻作废，门户永远把你弹回登录页 —— 公网入口全挂，
        # 而且**面板一点提示都没有**（它只看规则集，不看这两个文件）。
        #
        # 为什么重播 {} 不算「让已登出的 token 复活」的安全倒退：
        #   · 文件**被删**的情况本来就已经重播 {} 了（上面的 -s 判空），
        #     「坏文件」和「文件没了」对网关来说是同一件事。
        #   · 网关进程内的 last-known-good 只在**进程活着**期间有效；
        #     重启之后它本来就只剩磁盘上这份文件。文件坏了 = 吊销记录
        #     已经不可信，这不是重播能挽回的。
        #   · 保留坏内容另存一份（.corrupt），排障时能看到到底坏成什么样。
        #
        # 也就是说：可用性优先（网关得能登录），并且**如实留证据**。
        if [ ! -s "$_cfgdir/$f" ]; then
            printf '{}' > "$_cfgdir/$f" || return 1
        elif ! _json_object_ok "$_cfgdir/$f"; then
            _bad="$_cfgdir/$f.corrupt"
            mv "$_cfgdir/$f" "$_bad" 2>/dev/null \
                || cp "$_cfgdir/$f" "$_bad" 2>/dev/null || _bad=""
            [ -n "$_bad" ] && chmod 600 "$_bad" 2>/dev/null
            printf '{}' > "$_cfgdir/$f" || return 1
            echo "nftables-web-auth: ${f} 不是合法 JSON（已损坏），已重播为 {}" >&2
            [ -n "$_bad" ] && \
                echo "nftables-web-auth: 坏内容留存于 ${_bad}" >&2
        fi
        chown "${NFTWEB_UID}:${NFTWEB_GID}" "$_cfgdir/$f" || return 1
        chmod 600 "$_cfgdir/$f" || return 1
    done

    # 审计日志：网关追加写，面板只读。预建是因为 /var/log 不可写给非 root。
    _audit="/var/log/nftables-web-auth.log"
    [ -f "$_audit" ] || : > "$_audit" || return 1
    chown "${NFTWEB_UID}:${NFTWEB_GID}" "$_audit" || return 1
    chmod 640 "$_audit" || return 1

    return 0
}

get_port() {
    # 认证网关的监听端口。
    #
    # 来源只有一处：共享配置 /etc/nftables/nftables-web-config.json 里的
    # auth_api_port 字段，默认 8444（与 app.py 的 DEFAULT_CONFIG 一致）。
    #
    # ⚠️ 改了这个端口**必须重启网关进程**才生效 —— 端口是**进程启动时**
    # 从环境变量 AUTH_API_PORT 传进去的（auth_gateway.py 读 env，不是
    # 每个请求现读配置）。所以「改了配置没重启」= 面板去敲
    # 127.0.0.1:<新端口>，网关却还听着旧端口 —— 面板显示「网关异常」，
    # 而配置里明明写的是另一个数。面板侧要能看出「需要重启」。
    #
    # 为什么不用 grep/sed 解析 JSON：字段值可能带引号、可能嵌套、也可能
    # 出现在别的键的值里，正则解析出来的端口是随机的。
    #
    # 解析顺序 jsonfilter → python3：
    #   · jsonfilter 是 OpenWrt 的独立包（libubox），**不在 busybox 里**，
    #     不保证装了 —— 原来只靠它，设备上没装时 p 恒为空，于是
    #     auth_api_port **从来没被真正用上**，面板配的端口一律不生效，
    #     而且是静默的。
    #   · python3 设备上实测有（网关本身就是 python3 跑起来的）。
    #   · 两个都没有 → 用默认 8444。
    #
    # 读不到配置 / JSON 坏了 / 端口不是 1-65535 的整数 → **回落到 8444
    # 并打日志**。绝不把空值传下去：空值会让 auth_gateway.py 的
    # int(os.environ["AUTH_API_PORT"]) 直接抛异常，网关起不来。
    local port="8444"
    local cfg="/etc/nftables/nftables-web-config.json"
    local p=""

    if [ -f "$cfg" ]; then
        if command -v jsonfilter >/dev/null 2>&1; then
            p=$(jsonfilter -e '$.auth_api_port' "$cfg" 2>/dev/null)
        fi
        if [ -z "$p" ] && command -v python3 >/dev/null 2>&1; then
            p=$(python3 -c 'import json,sys
try:
    d = json.load(open(sys.argv[1]))
except Exception:
    sys.exit(0)
if isinstance(d, dict):
    sys.stdout.write(str(d.get("auth_api_port", "") or "").strip())
' "$cfg" 2>/dev/null)
        fi
    fi

    case "$p" in
        '')
            echo "nftables-web-auth: 读不到 ${cfg} 里的 auth_api_port，回落 8444" >&2
            ;;
        *[!0-9]*)
            echo "nftables-web-auth: auth_api_port 不是数字（${p}），回落 8444" >&2
            ;;
        *)
            # 端口必须是 1-65535 的整数。越界的值会让网关 bind 失败直接退出，
            # 面板那边只看到「网关异常」，配置里明明写的是别的数 —— 极难查。
            #
            # 用 awk 判断而不是 $(( ))：ash 的算术把 "08444" 当八进制会直接
            # 报错，awk 一律按十进制解析，还能顺手把前导零去掉。
            if awk -v v="$p" 'BEGIN { exit !(v ~ /^[0-9]+$/ && v+0 >= 1 && v+0 <= 65535) }'; then
                port=$(awk -v v="$p" 'BEGIN { printf "%d", v+0 }')
            else
                echo "nftables-web-auth: auth_api_port=${p} 不是 1-65535 的整数，回落 8444" >&2
            fi
            ;;
    esac
    echo "$port"
}

start() {
    if [ ! -f "$APP_DIR/auth_gateway.py" ]; then
        echo "nftables-web-auth: 找不到 $APP_DIR/auth_gateway.py，未安装或版本过旧"
        return 1
    fi

    if [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
        echo "nftables-web-auth is already running (PID $(cat "$PID_FILE"))"
        return 0
    fi

    local port
    # 端口在**这里**定死成进程的环境变量 —— 改了配置里的 auth_api_port
    # 必须重启本服务才生效（面板侧要能看出「需要重启」）。
    port=$(get_port)

    # ── 降权准备。任何一步失败都必须在这里停住：带着没配好的属主去启动，
    #    auth_gateway.py 会因为读不到密码文件而让登录全断，而且是静默的。
    if ! ensure_nftweb_user; then
        echo "nftables-web-auth: 创建 ${NFTWEB_USER} 失败，拒绝启动" >&2
        return 1
    fi
    if ! prepare_nftweb_files; then
        echo "nftables-web-auth: 准备 ${NFTWEB_USER} 的文件权限失败，拒绝启动" >&2
        return 1
    fi
    echo "Starting nftables-web-auth on 127.0.0.1:$port (uid ${NFTWEB_UID}:${NFTWEB_GID}) ..."
    cd "$APP_DIR" || return 1
    AUTH_BIND_HOST="$AUTH_BIND_HOST" AUTH_API_PORT="$port" \
        AUTH_DROP_UID="$NFTWEB_UID" AUTH_DROP_GID="$NFTWEB_GID" AUTH_DROP_USER="$NFTWEB_USER" \
        python3 auth_gateway.py >>"$AUTH_LOG" 2>&1 &
    echo $! > "$PID_FILE"

    # 进程活着不等于降权成功。auth_gateway.py 里降权失败是直接 exit 的，
    # 这里再核一次实际身份 —— 万一将来有人改坏了那段代码，这里是最后一道闸。
    #
    # 但必须**轮询等待**，不能固定 sleep 一次就下结论。
    #
    # 2026-10-16 .224 实测「进程启动 → 执行到 _drop_privileges()」的耗时：
    #     空闲            0.372 ~ 0.390s
    #     4 进程满载      0.790 ~ 0.857s   （距阈值只剩 0.14s 余量）
    #     8 进程满载      1.443 ~ 1.636s   （稳定越过 1s 阈值）
    # 原来的 `sleep 1` + 单次判定，在机器一忙时就会把完全健康的新进程当成
    # 「降权没生效」杀掉。实测踩中过：刚 OOM 完、tmpfs 还在回写时执行
    # restart，网关彻底起不来，只能人工处理；同一条命令在空闲时完全正常。
    # 守卫本身是对的（它防的确实是降权失败），错的只是等待方式。
    local pid real_uid waited=0
    pid=$(cat "$PID_FILE")
    while [ "$waited" -lt 150 ]; do
        kill -0 "$pid" 2>/dev/null || break          # 进程自己退了，交给下面的失败分支
        real_uid=$(awk '/^Uid:/ {print $2}' "/proc/$pid/status" 2>/dev/null)
        # 非空且非 0 才算降权完成；空说明 /proc 还没建好，继续等
        if [ -n "$real_uid" ] && [ "$real_uid" != "0" ]; then
            break
        fi
        sleep 0.1 2>/dev/null || sleep 1              # BusyBox 老版本不支持小数 sleep
        waited=$((waited + 1))
    done

    if kill -0 "$pid" 2>/dev/null; then
        real_uid=$(awk '/^Uid:/ {print $2}' "/proc/$pid/status" 2>/dev/null)
        if [ "$real_uid" = "0" ] || [ -z "$real_uid" ]; then
            echo "nftables-web-auth: 等待 ${waited}0ms 后 uid 仍为 ${real_uid:-未知}，降权未生效 —— 停掉它" >&2
            kill "$pid" 2>/dev/null
            rm -f "$PID_FILE"
            return 1
        fi
        echo "Started nftables-web-auth (PID $pid, uid $real_uid)"
        # 认证服务必须能起来，否则 nginx 的 auth_request 会全部 502，
        # 公网入口等于全断。这里失败要说清楚，不要静默。
        return 0
    fi

    rm -f "$PID_FILE"
    echo "nftables-web-auth 启动失败，日志见 $AUTH_LOG"
    tail -n 20 "$AUTH_LOG" 2>/dev/null
    return 1
}

stop() {
    if [ -f "$PID_FILE" ]; then
        local pid
        pid=$(cat "$PID_FILE")
        if kill -0 "$pid" 2>/dev/null; then
            echo "Stopping nftables-web-auth (PID $pid)..."
            kill "$pid"
            # 给一点时间优雅退出，auth_gateway 每次响应都会落审计日志
            local i=0
            while [ $i -lt 20 ] && kill -0 "$pid" 2>/dev/null; do
                sleep 0.1 2>/dev/null || sleep 1
                i=$((i + 1))
            done
            kill -0 "$pid" 2>/dev/null && kill -9 "$pid" 2>/dev/null
        fi
        rm -f "$PID_FILE"
        echo "Stopped"
    else
        echo "nftables-web-auth is not running"
    fi
}

status() {
    if [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
        echo "nftables-web-auth is running (PID $(cat "$PID_FILE"))"
        return 0
    fi
    echo "nftables-web-auth is not running"
    return 1
}

restart() {
    stop
    sleep 1
    start
}
